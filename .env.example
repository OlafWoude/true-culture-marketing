# Copy to .env.local for local development. Never commit real values.

# Postgres (on Vercel: Storage → Neon; both are filled in automatically)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Image uploads (on Vercel: Storage → Blob; filled in automatically)
BLOB_READ_WRITE_TOKEN=

# One-time key for creating the first admin at /admin/setup and for the
# emergency password procedure. At least 24 random characters.
ADMIN_SETUP_TOKEN=

# Public address of the site, used in password reset links and the sitemap
SITE_URL=

# E-mail via Resend (contact form notifications and password reset)
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_TO_EMAIL=
